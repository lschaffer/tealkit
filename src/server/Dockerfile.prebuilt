# Dockerfile.prebuilt — Build the Docker image from an already-compiled binary.
#
# Use this when you have already run build-server-binary.ps1 and don't want to
# recompile Dart inside Docker.  The binary must exist at:
#   server/build/tealkit_server
#
# Build context must be the repo root (same as the regular Dockerfile):
#   docker build -f server/Dockerfile.prebuilt -t tealkit_server:latest .

# ── Stage 1: Downloader ──────────────────────────────────────────────────────
# Downloads the correct DuckDB binary depending on target architecture.
FROM debian:trixie-slim AS downloader
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends curl unzip && rm -rf /var/lib/apt/lists/*

WORKDIR /libs
COPY third_party/dart_duckdb/linux/Libraries/release/libduckdb.so /libs/libduckdb.so

RUN if [ "$TARGETARCH" = "arm64" ]; then \
      curl -L -o /tmp/duckdb.zip https://github.com/duckdb/duckdb/releases/download/v1.4.1/libduckdb-linux-arm64.zip && \
      unzip -o /tmp/duckdb.zip -d /libs && \
      rm -f /tmp/duckdb.zip; \
    fi

# ── Stage 2: Helper ──────────────────────────────────────────────────────────
# Statically-compiled BusyBox provides:
#   • mkdir to pre-create the data directory skeleton
#   • wget for Docker health checks (invoked as /usr/bin/wget at runtime)
FROM busybox:1.37 AS helper

RUN mkdir -p /data/db /data/output /data/logs

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
# Google Distroless cc — zero known CVEs, no shell, no package manager.
# Ships only glibc, libstdc++, libgcc-s and CA certificates — exactly what
# the AOT-compiled server binary and libduckdb.so require.
FROM gcr.io/distroless/cc-debian12 AS runtime

WORKDIR /app

# Pre-compiled server binary (produced by build-server-binary.ps1).
# Must exist at server/build/tealkit_server before running docker build.
COPY server/build/tealkit_server /app/tealkit_server

# DuckDB shared library alongside the binary.
# LD_LIBRARY_PATH=/app lets the linker find it without ldconfig.
COPY --from=downloader /libs/libduckdb.so /app/libduckdb.so

# Statically-compiled BusyBox aliased as wget for Docker HEALTHCHECK.
COPY --from=helper /bin/busybox /usr/bin/wget

# Pre-created data directory skeleton (server writes db, output and logs here)
COPY --from=helper /data /data

# Data volume — override mount point in docker-compose or with -v
VOLUME ["/data"]

ENV TEALKIT_DATA_DIR=/data \
    TEALKIT_PORT=7771 \
    TEALKIT_HOST=0.0.0.0 \
    LD_LIBRARY_PATH=/app

EXPOSE 7771

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/usr/bin/wget", "-qO-", "http://localhost:7771/health"]

ENTRYPOINT ["/app/tealkit_server"]
