# External MCP Servers Configuration Sample
# Define stdio subprocesses or remote SSE endpoints for MCP tools
servers:
  - id: "filesystem"
    name: "Local Filesystem MCP"
    is_local: true
    local_type: "nodejs"
    local_install_method: "npx"
    local_package: "@modelcontextprotocol/server-filesystem"
    custom_launch_command: "npx -y @modelcontextprotocol/server-filesystem ."
    enabled: true

  - id: "fetch"
    name: "Web Fetch MCP"
    is_local: true
    local_type: "python"
    local_install_method: "uvx"
    local_package: "mcp-server-fetch"
    custom_launch_command: "uvx mcp-server-fetch"
    enabled: true

  # Remote HTTP/HTTPS MCP Server
  - id: "remote_api"
    name: "Remote HTTP MCP Server"
    url: "https://mcp.yourdomain.com/mcp"
    mcp_endpoint: "/mcp"
    is_local: false
    api_key: "${REMOTE_MCP_API_KEY}"
    enabled: true
